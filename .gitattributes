# Normalize all text files to LF in the repo and the working tree
* text=auto eol=lf

# Binary files: never alter line endings
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.gz    binary
*.zip   binary
